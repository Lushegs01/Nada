{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      // Turbo hashes and filters the environment, so a variable the tests read
      // is invisible unless it is declared here. Without this the contest
      // integration suites skipped silently under `pnpm test` while passing
      // when vitest was invoked directly.
      "env": ["TEST_DATABASE_URL", "CONTEST_TEST_DATABASE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
