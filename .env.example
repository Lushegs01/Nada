# ── WebRTC TURN Server (required for calls across strict NAT/firewalls) ────────
# Get credentials at: https://dashboard.metered.ca
# The TURN server URLs are pre-configured in apps/web/src/lib/webrtc.ts
# You only need to provide your Metered account credentials.
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ── Web Push Notification VAPID Keys ──────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nada.local
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
