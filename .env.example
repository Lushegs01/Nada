NEXT_PUBLIC_RELAY_URL=
ALLOWED_ORIGIN=
PORT=
ZERO_LOG_MODE=true
# Server-side escape hatch for the dev-only plaintext debug field. The relay
# strips `devPlaintext` from every envelope it forwards or queues unless this
# is exactly "true". Leave unset everywhere except a local machine.
ALLOW_DEV_PLAINTEXT=

# Dev-only: ships plaintext alongside ciphertext so local dev can read messages
# without full crypto wired up. NEVER enable on production — module init throws
# if NODE_ENV=production and this is true. Leave unset (or "false") otherwise.
NEXT_PUBLIC_NADA_DEV_PLAINTEXT=
DATABASE_URL=
# Max pooled Postgres connections per relay instance. Keep
# instances * DATABASE_POOL_MAX under the database's connection limit.
DATABASE_POOL_MAX=10
# Required in production: offline envelope queue, shared rate-limit counters,
# and the pub/sub channels that let one instance deliver to a socket held by
# another. Without it the relay is limited to a single instance and loses
# queued envelopes on restart.
REDIS_URL=
RELAY_QUEUE_TTL_SECONDS=
MEDIA_MAX_BYTES=26214400

# ── Media storage ─────────────────────────────────────────────────────────────
# Local disk is development-only: container filesystems are wiped on deploy and
# are not shared between instances. Set the S3 vars below in production (AWS S3,
# Cloudflare R2, MinIO, B2 — anything S3-compatible).
MEDIA_STORAGE_DIR=.nada-media
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
# Set for S3-compatible providers; omit for AWS S3 itself.
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Attachment retention window in seconds (default 30 days). The relay refuses
# to serve an object past this age; set the bucket lifecycle rule to match so
# the bytes are reclaimed rather than merely hidden.
MEDIA_TTL_SECONDS=2592000

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Per-identity budget per minute. Applies to requests that name an identity.
RATE_LIMIT_IDENTITY_MAX=240
# Per-IP budget per minute, applied ONLY to requests carrying no identity.
# Identity-bearing traffic must never be counted per-IP: a campus NAT presents
# thousands of students as a single address.
RATE_LIMIT_IP_MAX=600
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=
CAPABILITY_TOKEN_SECRET=
CAPABILITY_ISSUER_SECRET=

# ── CampOS SSO ────────────────────────────────────────────────────────────────
# Shared secret used to verify the token returned by the server-to-server
# one-time code exchange. MUST equal CampOS Core's SSO_JWT_SECRET_NADA
# (or its shared SSO_JWT_SECRET fallback). Server-side only — never expose via
# NEXT_PUBLIC_.
CAMPOS_SSO_SECRET=
# Public HTTPS origin used only by the NADA server to exchange SSO codes.
CAMPOS_CORE_URL=https://campos-core.vercel.app

WEB_PORT=
RELAY_PORT=
PLAYWRIGHT_BASE_URL=

# Preferred over TURN_USERNAME/TURN_CREDENTIAL: the relay derives a per-user,
# time-limited HMAC credential (RFC 8489) from this instead of handing every
# caller the same static, never-rotating pair. Must match the TURN server's
# configured secret.
TURN_SHARED_SECRET=

# ── WebRTC TURN Server (required for calls across strict NAT/firewalls) ────────
# Get credentials at: https://dashboard.metered.ca
# Credentials live ONLY on the relay now and are issued to clients via
# POST /api/v1/turn/credentials after a signed identity proof. They must NOT
# be exposed via NEXT_PUBLIC_ env vars or the client JS bundle.
TURN_USERNAME=
TURN_CREDENTIAL=
# Comma-separated list of TURN server URLs (defaults to Metered global if unset).
TURN_URLS=

# ── Web Push Notification VAPID Keys ──────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nada.local
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
