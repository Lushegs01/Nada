    "@fastify/rate-limit": "9.1.0",
    "@fastify/websocket": "8.3.1",
    "@nada/db": "workspace:0.1.0",
    "@nada/types": "workspace:0.1.0",
    "fastify": "4.29.1",
    "pg": "8.16.3",
    "pino": "9.9.0",
    "redis": "4.7.1",
    "stripe": "18.5.0",
    "ws": "8.18.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1",
    "eslint": "8.57.1",
    "rimraf": "6.0.1",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "vitest": "3.2.4"
  }
